terraform {
  required_version = ">= 1.8"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    talos = {
      source  = "siderolabs/talos"
      version = "~> 0.7"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.17"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Required for Route53 query logging — CloudWatch log groups for Route53 must be in us-east-1.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
}

provider "talos" {}

# ─── Talos API client credentials ────────────────────────────────────────────
# Read from the local talosconfig generated by `talosctl gen config`.
# Context name follows the convention created by talosctl: admin@<cluster-name>.
locals {
  _talosconfig = yamldecode(file(pathexpand(var.talosconfig_path)))
  _cluster_ctx = local._talosconfig.contexts["admin@${var.cluster_name}"]
}

# ─── Kubeconfig retrieval ─────────────────────────────────────────────────────
# Equivalent to: talosctl kubeconfig --nodes <control-plane-ip>
# Requires cluster to be bootstrapped and reachable (port 50000 on control plane nodes).
# On initial infra provisioning use -target on the node modules first, then apply in full.
data "talos_cluster_kubeconfig" "this" {
  client_configuration = {
    ca_certificate     = local._cluster_ctx.ca
    client_certificate = local._cluster_ctx.crt
    client_key         = local._cluster_ctx.key
  }
  node = module.cluster_controlplane_nodes.instance_private_ips[0]
}

locals {
  _cluster_kube = yamldecode(data.talos_cluster_kubeconfig.this.kubeconfig_raw)
}

# ─── Helm provider ────────────────────────────────────────────────────────────

provider "helm" {
  kubernetes {
    host                   = local._cluster_kube.clusters[0].cluster.server
    cluster_ca_certificate = base64decode(local._cluster_kube.clusters[0].cluster["certificate-authority-data"])
    client_certificate     = base64decode(local._cluster_kube.users[0].user["client-certificate-data"])
    client_key             = base64decode(local._cluster_kube.users[0].user["client-key-data"])
  }
}
