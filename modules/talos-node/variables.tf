# ─── Cluster identity ────────────────────────────────────────────────────────

variable "cluster_name" {
  description = "Name of the Talos/Kubernetes cluster. Must match the value used in VPC subnet tags."
  type        = string
}

variable "node_role" {
  description = "Role of this node group: 'controlplane' or 'worker'."
  type        = string
  validation {
    condition     = contains(["controlplane", "worker"], var.node_role)
    error_message = "node_role must be 'controlplane' or 'worker'."
  }
}

# ─── Network ─────────────────────────────────────────────────────────────────

variable "vpc_id" {
  description = "VPC ID where nodes will be deployed."
  type        = string
}

variable "vpc_cidr" {
  description = "CIDR block of the VPC, used to scope intra-cluster security group rules."
  type        = string
}

variable "subnet_ids" {
  description = "Subnet IDs for node placement. For control plane, spread across AZs for etcd quorum."
  type        = list(string)
}

variable "peer_security_group_ids" {
  description = "Security group IDs of other node groups (e.g., workers → control plane). Allows full intra-cluster traffic."
  type        = list(string)
  default     = []
}

variable "kube_api_allowed_cidrs" {
  description = "CIDRs permitted to reach the Kubernetes API server (port 6443). Control plane only."
  type        = list(string)
  default     = []
}

variable "talos_api_allowed_cidrs" {
  description = "CIDRs permitted to reach the Talos API (port 50000) for talosctl access."
  type        = list(string)
  default     = []
}

variable "rancher_server_cidrs" {
  description = "CIDRs for Rancher server, used to open the RKE2 supervisor port (9345) for cluster import."
  type        = list(string)
  default     = []
}

variable "nodeport_allowed_cidr" {
  description = "CIDR allowed to reach NodePort range (30000-32767). Typically the VPC CIDR so ALB/NLB target groups can reach nodes."
  type        = string
  default     = "0.0.0.0/0"
}

# ─── Instance configuration ───────────────────────────────────────────────────

variable "ami_id" {
  description = "Talos Linux AMI ID. Find current IDs at https://github.com/siderolabs/talos/releases (look for AWS AMI release assets)."
  type        = string
}

variable "instance_type" {
  description = "EC2 instance type."
  type        = string
  default     = "m6i.xlarge"
}

variable "instance_count" {
  description = "Number of instances. For control plane use 3 or 5 (odd, for etcd quorum); for workers this sets ASG desired capacity."
  type        = number
  default     = 3
}

variable "min_size" {
  description = "ASG minimum size. Only applies when node_role = 'worker'."
  type        = number
  default     = 1
}

variable "max_size" {
  description = "ASG maximum size. Only applies when node_role = 'worker'."
  type        = number
  default     = 10
}

variable "talos_machine_config" {
  description = "Base64-encoded Talos machine configuration generated by talosctl. Pass controlplane or worker config as appropriate."
  type        = string
  sensitive   = true
}

variable "root_volume_size_gb" {
  description = "Root EBS volume size in GiB. Talos minimum is 10 GiB; GPU/Longhorn workers need more."
  type        = number
  default     = 100
}

variable "root_volume_type" {
  description = "EBS volume type."
  type        = string
  default     = "gp3"
}

variable "longhorn_volume_size_gb" {
  description = "Longhorn EBS volume size in GiB. Talos minimum is 10 GiB; GPU/Longhorn workers need more."
  type        = number
  default     = 100
}

variable "longhorn_volume_type" {
  description = "Longhorn EBS volume type."
  type        = string
  default     = "gp3"
}

variable "ebs_optimized" {
  description = "Enable EBS optimization on the instance."
  type        = bool
  default     = true
}

variable "use_spot" {
  description = "Use EC2 Spot instances. Not recommended for control plane."
  type        = bool
  default     = false
}

variable "spot_max_price" {
  description = "Maximum Spot price per hour. Leave null to cap at on-demand price."
  type        = string
  default     = null
}

variable "enable_detailed_monitoring" {
  description = "Enable 1-minute CloudWatch detailed monitoring."
  type        = bool
  default     = false
}

# ─── Cilium options ───────────────────────────────────────────────────────────

variable "cilium_enable_vxlan" {
  description = "Open UDP 8472 for Cilium VXLAN overlay. Set false when using native routing mode (routingMode: native)."
  type        = bool
  default     = false
}

variable "cilium_enable_wireguard" {
  description = "Open UDP 51871 for Cilium WireGuard node-to-node encryption."
  type        = bool
  default     = false
}

# ─── IAM ─────────────────────────────────────────────────────────────────────

variable "create_iam_resources" {
  description = "When true, creates an IAM role and instance profile for nodes. Set false to supply an existing profile via iam_instance_profile_name."
  type        = bool
  default     = true
}

variable "iam_instance_profile_name" {
  description = "Existing IAM instance profile name. Used only when create_iam_resources = false."
  type        = string
  default     = null
}

variable "create_lb_controller_irsa" {
  description = "Create the IAM role for the AWS Load Balancer Controller (IRSA). Enable on exactly one module instance per cluster."
  type        = bool
  default     = false
}

variable "oidc_provider_arn" {
  description = "ARN of the OIDC provider for IRSA. Required when create_lb_controller_irsa = true or create_external_dns_irsa = true."
  type        = string
  default     = ""
}

variable "oidc_provider_url" {
  description = "URL of the OIDC provider (without https://). Required when create_lb_controller_irsa = true or create_external_dns_irsa = true."
  type        = string
  default     = ""
}

variable "lb_controller_namespace" {
  description = "Kubernetes namespace where the AWS Load Balancer Controller service account lives."
  type        = string
  default     = "kube-system"
}

variable "lb_controller_service_account" {
  description = "Kubernetes service account name for the AWS Load Balancer Controller."
  type        = string
  default     = "aws-load-balancer-controller"
}

variable "create_external_dns_irsa" {
  description = "Create the IAM role for external-dns (IRSA). Enable on exactly one module instance per cluster."
  type        = bool
  default     = false
}

variable "external_dns_service_account" {
  description = "Kubernetes service account name for external-dns."
  type        = string
  default     = "external-dns"
}

variable "external_dns_namespace" {
  description = "Kubernetes namespace where the external-dns service account lives."
  type        = string
  default     = "external-dns"
}

# ─── Tagging ─────────────────────────────────────────────────────────────────

variable "tags" {
  description = "Additional tags applied to all resources."
  type        = map(string)
  default     = {}
}
