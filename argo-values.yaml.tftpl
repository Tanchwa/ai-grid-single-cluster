server:
  # Certificate is managed by the argo-bootstrap chart after install, which creates the letsencrypt-prod
  # ClusterIssuer and a Certificate CR targeting the argocd-server-tls secret. ArgoCD picks it up automatically.
  certificate:
    enabled: false

  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: "external"
      service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "instance"
      service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
      service.beta.kubernetes.io/aws-load-balancer-subnets: "${public_subnets}"
      service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags: "argocd-cluster=${cluster_name}"
    servicePortHttps: 443

  ingress:
    enabled: false

configs:
  params:
    server.insecure: "false"
  cm:
    oidc.config: |
      name: Keycloak
      issuer: ${argocd_oidc_issuer}
      clientID: ${argocd_oidc_client_id}
      clientSecret: $oidc.keycloak.clientSecret
      refreshTokenThreshold: 2m
      requestedScopes: ["openid", "profile", "email", "groups"]
      requestedIDTokenClaims:
        groups:
          essential: true
    resource.exclusions: |
      - apiGroups:
        - cilium.io
        kinds:
        - CiliumEndpoint
        - CiliumEndpointSlice
        - CiliumIdentity
        - CiliumNode
        clusters:
        - "*"
