server:
  # Certificate is managed by the argo-bootstrap chart after install, which creates the cloudflare-dev
  # ClusterIssuer and a Certificate CR targeting the argocd-server-tls secret. ArgoCD picks it up automatically.
  certificate:
    enabled: false

  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: "external"
      service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "instance"
      service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
      service.beta.kubernetes.io/aws-load-balancer-subnets: "${public_subnets}"
      service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags: "argocd-cluster=${cluster_name}"
    servicePortHttps: 443

  ingress:
    enabled: false

configs:
  params:
    server.insecure: "false"
  cm:
    oidc.config: |
      name: Azure Entra ID
      # issuer must be the v2.0 endpoint: https://login.microsoftonline.com/<tenant-id>/v2.0
      issuer: ${argocd_oidc_issuer}
      clientID: ${argocd_oidc_client_id}
      clientSecret: $oidc.azure.clientSecret
      refreshTokenThreshold: 2m
      # Entra has no "groups" scope — group membership is delivered via an app-registration
      # optional claim, requested below through requestedIDTokenClaims. Configure the "groups"
      # optional claim (ID token) on the Entra app registration, or the claim will be absent.
      requestedScopes: ["openid", "profile", "email"]
      requestedIDTokenClaims:
        groups:
          essential: true
    resource.exclusions: |
      - apiGroups:
        - cilium.io
        kinds:
        - CiliumEndpoint
        - CiliumEndpointSlice
        - CiliumIdentity
        - CiliumNode
        clusters:
        - "*"
